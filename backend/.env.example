# Anthropic Claude API 키 (감정 분류)
ANTHROPIC_API_KEY=

# Supabase 프로젝트 URL (Project Settings > API)
SUPABASE_URL=

# Supabase API 키. RLS가 public.memes에 공개 SELECT 정책 없이 활성화되어 있다면
# anon key가 아닌 service_role key를 사용해야 합니다. 백엔드에서만 사용되고
# 프론트엔드에는 절대 노출되지 않으므로 service_role key 사용이 안전합니다.
SUPABASE_KEY=

# CORS 허용 origin(쉼표로 여러 개 구분). 비워두면 로컬 개발 서버(localhost:5173)만 허용.
# *.vercel.app 도메인(프리뷰 URL 포함)은 app.py의 allow_origin_regex로 항상 허용되므로
# 여기엔 로컬 개발 주소나 커스텀 도메인만 추가하면 됨.
ALLOWED_ORIGINS=http://localhost:5173
